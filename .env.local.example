# ============================================================================
# Environment Variables Template - Copy to .env.local
# ============================================================================
#
# CRITICAL FOR DATA ISOLATION:
# - VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY enable secure Supabase connection
# - These values must be kept secret in production
# - The Supabase project enforces RLS policies at database level
#
# SETUP INSTRUCTIONS:
# 1. Go to https://supabase.com and create a new project
# 2. Navigate to Project Settings > API
# 3. Copy the Project URL to VITE_SUPABASE_URL
# 4. Copy the anon key to VITE_SUPABASE_ANON_KEY
# 5. Create .env.local file in project root
# 6. Copy these variables and fill in the actual values
# 7. DO NOT commit .env.local to version control

# ============================================================================
# Supabase Configuration
# ============================================================================

# The Supabase project URL
# Format: https://[project-ref].supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# The anonymous key for client-side access
# Used for unauthenticated operations before user logs in
VITE_SUPABASE_ANON_KEY=your-anonymous-key-here

# ============================================================================
# Google Gemini API (Optional - for AI features)
# ============================================================================

VITE_GOOGLE_GENERATIVE_AI_KEY=your-gemini-key-here

# ============================================================================
# App Configuration
# ============================================================================

# Environment mode (development, production, staging)
VITE_APP_ENV=development

# ============================================================================
# Deployment Configuration
# ============================================================================

# For Vercel deployment
# These will be set automatically in Vercel project settings
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_GOOGLE_GENERATIVE_AI_KEY=

# ============================================================================
# Security Notes
# ============================================================================
#
# PRODUCTION SECURITY CHECKLIST:
# 
# 1. SUPABASE RLS ENFORCEMENT
#    - All tables have RLS policies enabled
#    - Row Level Security policies are enforced at database level
#    - Users can ONLY access their own data, even with direct SQL
#    
# 2. AUTHENTICATION
#    - Use Supabase Auth (built-in to this setup)
#    - JWT tokens are validated server-side
#    - Sessions expire automatically
#    
# 3. DATA ISOLATION
#    - Every query includes userId filter
#    - Users cannot modify userId in their data
#    - Test ownership is verified before returning results
#    
# 4. HTTPS ONLY
#    - All connections must use HTTPS
#    - API keys should never be exposed in URLs
#    
# 5. SECRET MANAGEMENT
#    - Never commit .env.local to version control
#    - Use deployment platform's secret manager
#    - Rotate keys periodically
#
